[Unit]
Description=Prune old unused Forgejo runner Docker resources
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Explicitly target the nested daemon, leaving host Docker resources alone.
# Docker's age filter uses creation time, not last use. Running containers
# and their images are excluded by Docker's prune commands.
ExecStart=/usr/bin/docker exec forgejo-runner-docker docker --host unix:///var/run/docker.sock container prune --force --filter until=168h
ExecStart=/usr/bin/docker exec forgejo-runner-docker docker --host unix:///var/run/docker.sock image prune --all --force --filter until=168h
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
