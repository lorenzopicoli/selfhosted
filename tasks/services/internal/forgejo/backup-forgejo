#!/usr/bin/env bash
set -Eeuo pipefail

# Prevent a timer and a manual run from backing up at the same time.
exec 9>/run/lock/backup-forgejo.lock
flock --nonblock 9 || { echo "Forgejo backup is already running" >&2; exit 1; }

# Root-only credentials for calling the local Backrest API.
source /etc/selfhosted-backup/backrest-api.env

# Always address the same Compose project and file Ansible deploys.
compose=(docker compose --project-name forgejo --file /home/lorenzo/configs/docker-compose.yml)
export_dir=/var/lib/selfhosted-backup/forgejo
mkdir -p "$export_dir"

if [[ $(docker inspect --format '{{ .State.Running }}' forgejo 2>/dev/null || true) != true ]]; then
  echo "Forgejo is not running; refusing to change its state" >&2
  exit 1
fi

tmp=$(mktemp "$export_dir/.database.dump.XXXXXX")
forgejo_stopped=false
# EXIT runs on success, command failure, or interruption. It removes an incomplete
# dump and restarts Forgejo only if this script was the process that stopped it.
cleanup() {
  status=$?
  trap - EXIT
  [[ -z "$tmp" ]] || rm -f "$tmp"
  if [[ $forgejo_stopped == true ]] && ! "${compose[@]}" start server; then
    echo "Failed to restart Forgejo" >&2
    [[ $status -ne 0 ]] || status=1
  fi
  exit "$status"
}
trap cleanup EXIT

# Stop only the Forgejo application. PostgreSQL remains available for pg_dump.
"${compose[@]}" stop --timeout 60 server
forgejo_stopped=true

# Create a transaction-consistent custom-format dump inside the DB container.
"${compose[@]}" exec -T db sh -ec \
  'exec pg_dump --format=custom --username="$POSTGRES_USER" --dbname="$POSTGRES_DB"' > "$tmp"
# Listing the archive verifies that pg_restore can parse it before it is used.
"${compose[@]}" exec -T db pg_restore --list < "$tmp" > /dev/null

chmod 0600 "$tmp"
# Replace the previous export atomically, so Backrest never sees a partial dump.
mv -f "$tmp" "$export_dir/database.dump"
tmp=

# Record when this export was made and a checksum useful during restore testing.
{
  printf 'created_at=%s\n' "$(date --iso-8601=seconds)"
  sha256sum "$export_dir/database.dump"
} > "$export_dir/manifest.txt"
chmod 0600 "$export_dir/manifest.txt"

# Trigger the plan named "forgejo". The call blocks while Backrest reads /data
# and uploads it, so the EXIT handler restarts Forgejo only after backup ends.
curl --fail --silent --show-error \
  --user "$BACKREST_API_USER:$BACKREST_API_PASSWORD" \
  --header 'Content-Type: application/json' \
  --data '{"value":"forgejo"}' \
  "$BACKREST_API_URL/v1.Backrest/Backup"
